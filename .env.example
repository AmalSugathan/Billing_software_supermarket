# Development only. Runtime credentials must be separate in production.
DATABASE_URL=postgresql+psycopg://supermarket_app:local_app_only@127.0.0.1:55432/supermarket_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://supermarket_dev:local_dev_only@127.0.0.1:55432/supermarket_dev
TEST_DATABASE_URL=postgresql+psycopg://supermarket_dev:local_dev_only@127.0.0.1:55432/supermarket_dev
APP_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080

# OCR intake is disabled until a private 32-byte Base64 AES key is supplied.
# Keep the key in a secret store and back it up separately from the database.
OCR_ENCRYPTION_KEY=
# Separate PaddleOCR-VL-1.6 full-document server; loopback HTTP root only.
# Leave unset if inference is unavailable. Upload/review still works with the key.
OCR_SERVICE_URL=
